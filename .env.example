# ──────────────────────────────────────────────
# Imperial Media — Variabile de mediu
# Copiază în .env.local pentru dev local.
# Pe Railway, setează-le în Settings → Variables.
# ──────────────────────────────────────────────

# ─── Anthropic Claude API (Brief AI conversațional) ───
# Obține cheia de la https://console.anthropic.com
# Folosim modelul Haiku 4.5 (rapid + ieftin, ~$1/MTok input)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Resend API — pentru trimiterea emailurilor ───
# Înregistrează-te gratis pe https://resend.com și obține cheia
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email-ul de la care pleacă mailul (trebuie verificat în Resend dashboard)
# Format: "Nume <email@domeniu.ro>"
FROM_EMAIL=Imperial Media <noreply@imperial-media.ro>

# Email-ul pe care PRIMEȘTI lead-urile
LEAD_EMAIL=office@imperial-media.ro
